# Normalize text files to LF in the repository and on checkout, so a clone on
# any platform sees the same bytes the gate and `zig fmt` expect.
* text=auto eol=lf

# Committed binary fixtures — never touch line endings.
*.wasm binary
*.png binary

# Keep read-only historical / generated content out of GitHub's language stats.
docs/ja/archive/** linguist-documentation
# Append-only ledgers: parallel branches each add rows at the end, so a union
# merge is the correct resolution (the YAML and ledger gates still check it).
.dev/optimizations.md merge=union
.dev/debt.yaml merge=union
