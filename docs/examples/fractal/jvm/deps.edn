;; The JVM engines of the fractal demo: replikativ/raster (CPU, threads and
;; SIMD) and CUDA through uncomplicate/clojurecuda (GPU). No cljw involved.
;;   clojure -M:serve [port]   tile server for the page (default 8081)
;;   clojure -M:bench          golden-view benchmark of every available engine
;;   clojure -M:test           golden, property and mutation tests
;; --enable-preview lets released raster define its value classes on JDK 27
;; (fixed upstream in replikativ/raster#1574). A gitignored local.deps.edn may
;; point at local checkouts of raster and clojure-cpp.
{:paths ["src" "resources"]
 :deps {org.replikativ/raster {:mvn/version "0.2.1720"}
        uncomplicate/clojurecuda {:mvn/version "0.33.0"}}
 :aliases
 {:jvm {:jvm-opts ["--enable-preview"
                   "--add-modules=jdk.incubator.vector"
                   "--enable-native-access=ALL-UNNAMED"
                   "-Xss8m" "-XX:ReservedCodeCacheSize=512m"]}
  :serve {:main-opts ["-m" "fractal.main"]}
  :bench {:main-opts ["-m" "fractal.bench"]}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
